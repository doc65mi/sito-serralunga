# Proxy unico — Version: 1.03
# Sito e pannello sulla stessa porta: il pannello (Payload) risponde su /admin,
# /api e /_next; tutto il resto è il sito (Astro). Le API del sito sono /api/richiesta e /api/newsletter.
# Davanti può esserci un altro proxy (Coolify/Traefik): ci si fida delle sue intestazioni
# X-Forwarded-* solo se arriva da una rete privata.
# Intestazioni di sicurezza: niente incorporamento da altri siti, niente MIME indovinato,
# permessi del browser spenti, CSP sulle pagine del sito, pannello e API fuori dai motori
# di ricerca (le foto in /api/media/file restano indicizzabili).
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	# HSTS solo quando il sito è servito in HTTPS dal proxy che sta davanti.
	@https header X-Forwarded-Proto https
	header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"

	@pannello {
		path /admin* /api/* /_next/*
		not path /api/media/file/*
	}
	header @pannello X-Robots-Tag "noindex, nofollow"
	header @pannello Content-Security-Policy "frame-ancestors 'self'"

	# Le foto cambiano di rado: una settimana di cache nel browser.
	@foto path /api/media/file/*
	header @foto Cache-Control "public, max-age=604800"
	# Un SVG caricato non può eseguire script né caricare risorse.
	@svg path_regexp ^/api/media/file/.+\.svg$
	header @svg Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"

	@sito not path /admin* /api/* /_next/*
	# Fonti esterne ammesse solo per reCAPTCHA e per i codici di Sicurezza e tracciamento
	# (Google Analytics/Ads/Tag Manager, Microsoft Clarity, Meta Pixel, LinkedIn Insight),
	# che partono solo dopo il consenso nel banner dei cookie.
	header @sito Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://*.clarity.ms https://connect.facebook.net https://snap.licdn.com; font-src 'self' data:; connect-src 'self' https://www.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.google.com https://www.googleadservices.com https://*.clarity.ms https://www.facebook.com https://*.facebook.com https://px.ads.linkedin.com https://*.linkedin.com https://*.licdn.com; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://www.googletagmanager.com https://td.doubleclick.net https://*.doubleclick.net https://www.facebook.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

	route {
		respond /_salute "ok" 200
		reverse_proxy /api/richiesta web:4321
		reverse_proxy /api/newsletter web:4321
		reverse_proxy /admin* cms:3000
		reverse_proxy /api/* cms:3000
		reverse_proxy /_next/* cms:3000
		reverse_proxy web:4321
	}
}
