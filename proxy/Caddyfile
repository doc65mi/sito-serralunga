# Proxy unico — Version: 1.00
# Sito e pannello sulla stessa porta: il pannello (Payload) risponde su /admin,
# /api e /_next; tutto il resto è il sito (Astro). L'unica API del sito è /api/richiesta.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip
	route {
		reverse_proxy /api/richiesta web:4321
		reverse_proxy /admin* cms:3000
		reverse_proxy /api/* cms:3000
		reverse_proxy /_next/* cms:3000
		reverse_proxy web:4321
	}
}
