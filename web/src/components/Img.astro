---
/**
 * Immagine dal CMS con srcset. Se manca la foto mostra il segnaposto a strisce
 * (come nei template: "da fornire"). Le versioni ridotte sono in AVIF dentro <picture>;
 * il file caricato fa da riserva per i browser che non lo leggono. Il punto focale scelto nel CMS passa
 * da una variabile CSS, non da uno stile scritto a mano.
 */
import { fuoco, isMedia, originale, src, srcset, tipoRidotte, type Media } from '../lib/media'
import { traduttore } from '../lib/lingua'

interface Props {
  media?: Media | number | null
  alt?: string
  sizes?: string
  larghezza?: number
  priorita?: boolean
  class?: string
  nota?: string
  /** Percorso del campo immagine nel documento, per sostituirla dalla pagina. */
  campo?: string
  [attr: `data-${string}`]: unknown
}
const { media, alt, sizes = '100vw', larghezza = 1800, priorita = false, class: cls, nota, campo, ...rest } = Astro.props
const m = isMedia(media) ? media : null
const posizione = m ? fuoco(m) : undefined
const ridotte = m ? srcset(m) : ''
const tipo = m ? tipoRidotte(m) : undefined
const vettoriale = m?.mimeType === 'image/svg+xml'
---
{m ? (
  <picture class="im">
  {ridotte && tipo && !vettoriale && <source type={tipo} srcset={ridotte} sizes={sizes} />}
  <img
    src={ridotte && tipo && !vettoriale ? originale(m) : src(m, larghezza)}
    alt={alt ?? m.alt ?? ''}
    width={m.width}
    height={m.height}
    loading={priorita ? 'eager' : 'lazy'}
    fetchpriority={priorita ? 'high' : undefined}
    decoding="async"
    class={cls}
    data-campo-img={campo}
    {...rest}
    style={posizione ? `--fuoco:${posizione};object-position:var(--fuoco)` : undefined}
  />
  </picture>
) : (
  <span class:list={['segnaposto', cls]} role="img" aria-label={alt || traduttore(Astro.locals.lingua)('Immagine da fornire')} data-segnaposto data-campo-img={campo} {...rest}>
    {nota && <span class="nota-mono">{nota}</span>}
  </span>
)}
