---
/** Icona a tratto decorativa (Version: 1.00): il nome accessibile sta sempre nel link o nel pulsante. */
import { ICONE } from '../lib/icone'
interface Props { nome: string; dim?: number }
const { nome, dim = 22 } = Astro.props
---
<svg class="icona" width={dim} height={dim} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONE[nome] || ''} />
