---
/**
 * Scheda prodotto — Version: 1.02. Template: template/Aqua Lounger - Scheda tecnica.dc.html
 * Usata dalle schede del Catalogo (/catalogo/{categoria}/{slug}/) e dal vecchio /prodotti/{slug}/.
 * 1.02: foto in evidenza a slider con dissolvenza (frecce, punti-miniatura, swipe, tastiera, pausa)
 *       e lightbox a tutto schermo con scorrimento fra tutte le foto della scheda (viste, disegno,
 *       ambientazioni: attributo data-lb="prodotto"). Script in scripts/site.ts.
 * 1.01: quadrati 30×30 dei colori della cartella colori e disegno quotato (DisegnoQuotato.astro).
 * Taglio B2B: niente prezzi al pubblico, varianti con codice articolo e richiesta di preventivo.
 */
import Base from '../layouts/Base.astro'
import Img from './Img.astro'
import Testo from './Testo.astro'
import Frecce from './Frecce.astro'
import CardCase from './CardCase.astro'
import CardProdotto from './CardProdotto.astro'
import ModuloRichiesta from './ModuloRichiesta.astro'
import DisegnoQuotato from './DisegnoQuotato.astro'
import { SITO, type Doc } from '../lib/cms'
import { isMedia, src, urlFile } from '../lib/media'
import { chiaro, piatto } from '../lib/testo'
import { percorso, traduttore } from '../lib/lingua'
import { urlProdotto } from '../lib/catalogo'

interface Props {
  p: Doc
  /** Briciole fino alla categoria (la scheda si aggiunge da sola). */
  briciole: { nome: string; url: string }[]
  /** Altri prodotti della stessa categoria, se non ci sono correlati scelti a mano. */
  stessaCategoria?: Doc[]
  tutte?: Doc[]
}
const { p, briciole, stessaCategoria = [], tutte = [] } = Astro.props
const L = Astro.locals.lingua
const t = traduttore(L)
const u = (x?: string) => percorso(L, x)
const qui = urlProdotto(p, tutte)

const d: Doc | null = typeof p.designer === 'object' ? p.designer : null
const galleria: Doc[] = (p.galleria || []).filter((g: Doc) => isMedia(g.immagine))
const viste = galleria.length ? galleria.map((g) => g.immagine) : [p.immagine]
const casi: Doc[] = (p.caseHistory || []).filter((c: unknown) => typeof c === 'object')
const correlati: Doc[] = (p.correlati || []).map((c: Doc) => {
  const rel = typeof c.prodotto === 'object' ? c.prodotto : null
  return {
    nome: c.nome || rel?.nome,
    sotto: c.sottotitolo || rel?.etichettaCard,
    immagine: c.immagine || rel?.immagine,
    link: rel?.schedaPubblicata ? u(urlProdotto(rel, tutte)) : u(c.link),
  }
})
const pdf = isMedia(p.disegno?.file) ? urlFile(p.disegno.file) : null
const finiture: Doc[] = (p.finiture || []).filter((f: Doc) => f?.nome)
const codici = finiture.map((f) => f.codice).filter(Boolean)
const MATERIALI: Record<string, string> = { polietilene: t('Polietilene'), moleskin: 'Moleskin', corten: 'Corten', laccato: t('Laccato'), vellutato: t('Vellutato'), decorato: t('Decorato') }
const materiali = (p.materiali || []).map((m: string) => MATERIALI[m] || m)
// Colori scelti dalla cartella colori (collezione "colori"): quadrati 30×30 col colore pieno del campione.
const campioni: Doc[] = (p.campioni || []).filter((c: unknown) => c && typeof c === 'object' && ((c as Doc).hex || isMedia((c as Doc).campione)))
const q: Doc = p.disegno?.quote || {}
const conQuote = !!q.forma && q.altezza > 0 && (q.diametro > 0 || q.larghezza > 0)
const tondo = q.forma === 'cilindro' || q.forma === 'troncoConico'
const cmq = (v: number) => ({ '@type': 'QuantitativeValue', value: v, unitCode: 'CMT' })
const descrizione = p.seo?.descrizione || piatto(p.descrizione || '').slice(0, 158)

const jsonld = [{
  '@type': 'Product',
  '@id': `${SITO}${u(qui)}#prodotto`,
  name: p.nome,
  url: `${SITO}${u(qui)}`,
  description: piatto(p.descrizione || p.seo?.descrizione || ''),
  brand: { '@type': 'Brand', name: 'Serralunga' },
  manufacturer: { '@id': `${SITO}/#organizzazione` },
  category: p.tipologia || p.categoria,
  image: viste.filter(isMedia).map((m) => src(m, 1800)),
  sku: codici[0],
  material: materiali.length ? materiali.join(', ') : p.specifiche?.find((s: Doc) => /material/i.test(s.etichetta))?.valore,
  ...(campioni.length
    ? { color: campioni.map((c) => `${c.nome} (${c.codice})`).join(', ') }
    : finiture.length > 1 ? { color: finiture.slice(0, 40).map((f) => f.nome).join(', ') } : {}),
  ...(conQuote
    ? {
        height: cmq(q.altezza),
        width: cmq(tondo ? q.diametro : q.larghezza),
        depth: cmq(tondo ? q.diametro : q.profondita || q.larghezza),
        ...(q.peso > 0 ? { weight: { '@type': 'QuantitativeValue', value: q.peso, unitCode: 'KGM' } } : {}),
      }
    : {}),
  ...(d ? { creator: { '@type': 'Person', name: d.nome } } : {}),
}]
---
<Base
  titolo={p.seo?.titolo || `${p.nome} | Serralunga`}
  descrizione={descrizione}
  immagine={p.seo?.immagine || viste[0]}
  percorso={[...briciole, { nome: p.nome, url: qui }]}
  jsonld={jsonld}
  pagina={`prodotto-${p.slug}`}
  doc={`collections/prodotti/${p.id}`}
  blocchi={p.blocchi ?? []}
>
  <section class="prodotto" id="prodotto-scheda" aria-labelledby="prodotto-titolo">
    <div class="wrap prodotto__griglia">
      <div
        class="galleria"
        data-galleria
        data-intervallo="5000"
        role={viste.length > 1 ? 'region' : undefined}
        aria-roledescription={viste.length > 1 ? t('carosello') : undefined}
        aria-label={t('Foto del prodotto')}
      >
        <div class="galleria__palco" data-palco>
          {viste.map((v, k) => (
            <Img media={v} alt={isMedia(v) && v.alt ? undefined : `${p.nome} — ${t('Vista')} ${k + 1}`} class={k === 0 ? 'attiva' : ''} priorita={k === 0} sizes="(max-width: 900px) 100vw, 56vw" larghezza={1800} data-vista data-lb="prodotto" />
          ))}
          {isMedia(viste[0]) && (
            <button type="button" class="galleria__zoom" data-zoom aria-label={t('Ingrandisci la foto')}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM15.3 15.3 20 20M10.5 7.5v6M7.5 10.5h6" /></svg>
            </button>
          )}
          {viste.length > 1 && (
            <div class="galleria__comandi">
              <button type="button" data-verso="-1" aria-label={t('Foto precedente')}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M15 5l-7 7 7 7" /></svg></button>
              <span class="galleria__conto" aria-live="polite" data-conto>1 / {viste.length}</span>
              <button type="button" data-verso="1" aria-label={t('Foto successiva')}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg></button>
              <button type="button" class="galleria__pausa" data-pausa aria-pressed="false" aria-label={t('Ferma lo scorrimento delle foto')} hidden>
                <svg class="ico-pausa" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
                <svg class="ico-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M7 5l12 7-12 7z" /></svg>
              </button>
            </div>
          )}
        </div>
        {viste.length > 1 && (
          <div class="galleria__miniature" data-miniature>
            {viste.map((v, k) => (
              <button type="button" data-mini aria-current={k === 0 ? 'true' : 'false'} aria-label={`${t('Vista')} ${k + 1} ${t('di')} ${viste.length}`}>
                <Img media={v} alt="" sizes="120px" larghezza={400} />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="prodotto__info">
        <div class="prodotto__testa">
          {(p.categoria || p.tipologia) && <span class="kicker" data-campo={p.categoria ? 'categoria' : 'tipologia'}>{p.categoria || p.tipologia}</span>}
          <h1 class="prodotto__h1" id="prodotto-titolo" data-campo="nome">{p.nome}</h1>
          {(p.firma || d) && <div class="firma-riga"><span>{p.firma || `${t('Disegno di')} ${d?.nome}`}</span></div>}
        </div>
        <Testo class="prodotto__descr" campo="descrizione" t={p.descrizione} />
        {(p.colori || []).length > 0 && (
          <div class="colori">
            <span class="etichetta">{t('Cartella colori')}</span>
            <ul class="colori__elenco">
              {p.colori.map((c: Doc) => (
                <li title={c.nome} class={chiaro(c.hex) ? 'chiaro' : undefined} style={`background:${c.hex}`}><span class="sr-only">{c.nome}</span></li>
              ))}
            </ul>
            {p.notaColori && <span class="colori__nota" data-campo="notaColori">{p.notaColori}</span>}
          </div>
        )}
        {campioni.length > 0 && (
          <div class="campioni" id="prodotto-colori">
            <span class="etichetta">{t('Colori disponibili')}</span>
            <ul class="campioni__elenco">
              {campioni.map((c) => (
                <li class="campioni__voce">
                  <span
                    class:list={['campioni__quadrato', c.hex && chiaro(c.hex) && 'chiaro']}
                    style={c.hex ? `background:${c.hex}` : undefined}
                    aria-hidden="true"
                  >{!c.hex && <Img media={c.campione} alt="" sizes="30px" larghezza={400} />}</span>
                  <span class="campioni__codice">{c.codice}</span>
                  <span class="campioni__nome">{c.nome}</span>
                </li>
              ))}
            </ul>
            <a class="campioni__link" href={u('/materiali/colori/')}>{t('Cartella colori completa')}</a>
          </div>
        )}
        {(p.dimensioni || []).length > 0 && (
          <dl class="misure">
            {p.dimensioni.map((m: Doc) => <div><dt>{m.etichetta}</dt><dd>{m.valore}</dd></div>)}
          </dl>
        )}
        {conQuote && <DisegnoQuotato q={q} nome={p.nome} />}
        {finiture.length > 0 && (
          <details class="varianti" open={finiture.length <= 12}>
            <summary><span class="etichetta">{t('Varianti a listino')}</span> <span class="varianti__n">{finiture.length}</span></summary>
            <table class="varianti__tabella">
              <thead><tr><th scope="col">{t('Variante')}</th><th scope="col">{t('Codice articolo')}</th></tr></thead>
              <tbody>{finiture.map((f) => <tr><td>{f.nome}</td><td>{f.codice || '—'}</td></tr>)}</tbody>
            </table>
          </details>
        )}
        {(materiali.length > 0 || d) && (
          <dl class="misure misure--info">
            {materiali.length > 0 && <div><dt>{t('Materiale e finitura')}</dt><dd>{materiali.join(', ')}</dd></div>}
            {d && <div><dt>{t('Design')}</dt><dd>{d.nome}</dd></div>}
          </dl>
        )}
        <div class="btn-riga">
          <a href="#richiesta" class="btn btn--scuro">{p.pulsante || t('Richiedi scheda e campionatura')}</a>
          {(p.disegno?.immagine || pdf) && <a href={pdf || '#disegno'} class="btn btn--bordo" download={pdf ? '' : undefined}>{t('Disegno tecnico')}</a>}
        </div>
      </div>
    </div>
  </section>

  {(p.specifiche || []).length > 0 && (
    <section class="specifiche scuro" id="prodotto-specifiche" aria-label={t('Specifiche')}>
      <dl class="wrap">
        {p.specifiche.map((s: Doc) => <div><dt>{s.etichetta}</dt><dd>{s.valore}</dd></div>)}
      </dl>
    </section>
  )}

  {isMedia(p.disegno?.immagine) && (
    <section id="disegno" class="sez-int pad">
      <div class="disegno">
        <div class="intesta">
          <Testo as="h2" class="titolo" campo="disegno.titolo" t={p.disegno.titolo} />
          <Testo class="testo testo--s" campo="disegno.testo" t={p.disegno.testo} />
        </div>
        <div class="disegno__tavola"><Img campo="disegno.immagine" media={p.disegno.immagine} sizes="(max-width: 1180px) 100vw, 1060px" larghezza={1800} data-lb="prodotto" /></div>
      </div>
    </section>
  )}

  {(isMedia(p.ambiente?.immagineGrande) || (p.ambiente?.immagini || []).length > 0) && (
    <section class="pad ambiente-sez" id="prodotto-ambiente">
      <div class="wrap ambiente">
        <div class="intesta">
          <Testo as="h2" class="titolo titolo--m" campo="ambiente.titolo" t={p.ambiente.titolo} />
          <Testo class="testo testo--s" campo="ambiente.testo" t={p.ambiente.testo} />
        </div>
        {isMedia(p.ambiente.immagineGrande) && <div class="foto r-219"><Img campo="ambiente.immagineGrande" media={p.ambiente.immagineGrande} larghezza={2600} data-lb="prodotto" /></div>}
        {(p.ambiente.immagini || []).length > 0 && (
          <div class="tre-col">
            {p.ambiente.immagini.map((i: Doc) => <div class="foto r-43"><Img media={i.immagine} sizes="(max-width: 900px) 100vw, 33vw" larghezza={1000} data-lb="prodotto" /></div>)}
          </div>
        )}
      </div>
    </section>
  )}

  {d && (
    <section class="sez-int pad scuro" id="prodotto-designer">
      <div class="wrap firma">
        <div>
          {isMedia(d.ritratto) ? (
            <div class="foto foto--scura r-45"><Img media={d.ritratto} sizes="(max-width: 900px) 100vw, 40vw" larghezza={1000} /></div>
          ) : (
            <div class="foto r-45 segnaposto segnaposto--scuro">
              <Img media={d.ritratto} class="ritratto-tondo ritratto-tondo--l" sizes="170px" larghezza={400} />
              <span class="nota-mono">{t('ritratto in alta risoluzione\nda fornire')}</span>
            </div>
          )}
        </div>
        <div class="firma__testi">
          <span class="kicker">{p.firmaProgetto?.kicker || t('La firma del progetto')}</span>
          <h2 class="titolo">{d.nome}</h2>
          {(p.firmaProgetto?.testi || []).map((tx: Doc, k: number) => <Testo class="testo" campo={`firmaProgetto.testi.${k}.testo`} t={tx.testo} />)}
          {(d.numeri || []).length > 0 && (
            <div class="numeri-riga">
              {d.numeri.map((n: Doc) => <div><div class="numeri-riga__valore">{n.valore}</div><div class="etichetta">{n.etichetta}</div></div>)}
            </div>
          )}
          <a href={u(d.schedaPubblicata ? `/designer/${d.slug}/` : '/designer/')} class="btn btn--bordo-chiaro">{d.schedaPubblicata ? `${t('Scheda di')} ${d.nome}` : t('Tutti i designer Serralunga')}</a>
        </div>
      </div>
    </section>
  )}

  {(casi.length > 0 || (p.caseSegnaposto || []).length > 0) && (
    <section id="case" class="sez-int fondo-paper">
      <div class="wrap pad intesta">
        <div class="intesta__sx">
          <span class="kicker">{t('Case history')}</span>
          <Testo as="h2" class="titolo titolo--l" t={t('Dove questo\ndisegno è già di casa')} />
        </div>
        <Frecce rail="rail-case" />
      </div>
      <div class="rail rail--largo" id="rail-case" tabindex="0" aria-label={t('Case history')}>
        {casi.map((c) => <CardCase c={c} />)}
        {(p.caseSegnaposto || []).map((s: Doc) => <CardCase segnaposto={s} />)}
      </div>
    </section>
  )}

  {correlati.length === 0 && stessaCategoria.length > 0 && (
    <section class="sez-int pad fondo-chiaro" id="prodotto-stessa-categoria">
      <div class="wrap">
        <div class="intesta">
          <h2 class="titolo titolo--l">{t('Nella stessa categoria')}</h2>
          {briciole.length > 1 && <a class="btn btn--bordo" href={u(briciole[briciole.length - 1].url)}>{`${t('Tutto in')} ${briciole[briciole.length - 1].nome}`}</a>}
        </div>
        <div class="griglia-4 catalogo__griglia--4">
          {stessaCategoria.slice(0, 4).map((x) => <CardProdotto p={x} tutte={tutte} />)}
        </div>
      </div>
    </section>
  )}

  {correlati.length > 0 && (
    <section class="sez-int pad fondo-chiaro" id="prodotto-correlati">
      <div class="wrap">
        <div class="intesta">
          <h2 class="titolo titolo--l">{t('Prodotti correlati')}</h2>
          <Testo class="testo testo--s" campo="correlatiTesto" t={p.correlatiTesto} />
        </div>
        <div class="griglia-4">
          {correlati.map((c) => {
            const Tag = c.link ? 'a' : 'div'
            return (
              <Tag href={c.link} class="card">
                <div class="foto r-11 zoom"><Img media={c.immagine} sizes="(max-width: 560px) 100vw, 25vw" larghezza={1000} /></div>
                <div>
                  <div class="card__nome card__nome--s">{c.nome}</div>
                  {c.sotto && <div class="card__sotto">{c.sotto}</div>}
                </div>
              </Tag>
            )
          })}
        </div>
      </div>
    </section>
  )}

  <section id="richiesta" class="fascia-finale">
    <Img campo="richiesta.immagine" media={p.richiesta?.immagine || p.immagine} larghezza={2600} />
    <div class="fascia-finale__dentro">
      <div class="centro centro--s">
        <span class="kicker kicker--largo">{p.richiesta?.kicker || t('Documentazione contract')}</span>
        <Testo as="h2" class="titolo" campo="richiesta.titolo" t={p.richiesta?.titolo || t('Scheda tecnica,\ndisegni e campioni')} />
        <Testo class="testo" campo="richiesta.testo" t={p.richiesta?.testo} />
        <ModuloRichiesta pulsante={t('Richiedi preventivo')} pagina={`${t('Preventivo')}: ${p.nome}${codici[0] ? ` (${codici[0]})` : ''} — ${qui}`} />
      </div>
    </div>
  </section>
</Base>
