---
/**
 * Scheda prodotto — Version: 1.07. Template: template/Aqua Lounger - Scheda tecnica.dc.html
 * Usata dalle schede del Catalogo (/catalogo/{categoria}/{slug}/) e dal vecchio /prodotti/{slug}/.
 * 1.07: tutti i colori della variante (Corten dal catalogo PDF), foto aggiunte in galleria e modulo
 *       con scelta multipla dei colori e campo richieste (lib/specifiche.ts aggiunteScheda, per ora
 *       solo Cubotti Alto); tolta la tabella "Varianti disponibili" (i codici restano nei dati strutturati).
 * 1.05-1.06: titoli specifiche a 500, punti elenco, icone tonde, tendine riordinate.
 * 1.04: "Materiale e finitura" subito sotto i colori; tendine (Caratteristiche, Dimensioni con
 *       disegno quotato e disegno tecnico, Istruzioni per la cura, Informazioni sulla spedizione,
 *       Sistema di illuminazione se c'è) con i testi della scheda serralunga.com o del pannello;
 *       icone del catalogo (uso esterno, ambienti salini, Clean Fighter, UL94-V2) e domande
 *       frequenti con dati strutturati FAQPage, solo dove la scheda tecnica le prevede
 *       (lib/specifiche.ts). Domande e icone per ora solo in italiano.
 * 1.03: sotto ogni miniatura nome del colore e codice articolo della variante fotografata (anche
 *       sulla foto in evidenza, nel testo alternativo e nella lightbox): vedi coloreDellaFoto().
 * 1.02: foto in evidenza a slider con dissolvenza (frecce, punti-miniatura, swipe, tastiera, pausa)
 *       e lightbox a tutto schermo con scorrimento fra tutte le foto della scheda (viste, disegno,
 *       ambientazioni: attributo data-lb="prodotto"). Script in scripts/site.ts.
 * 1.01: quadrati 30×30 dei colori della cartella colori e disegno quotato (DisegnoQuotato.astro).
 * Taglio B2B: niente prezzi al pubblico, varianti con codice articolo e richiesta di preventivo.
 */
import Base from '../layouts/Base.astro'
import Img from './Img.astro'
import Testo from './Testo.astro'
import Frecce from './Frecce.astro'
import CardCase from './CardCase.astro'
import CardProdotto from './CardProdotto.astro'
import ModuloRichiesta from './ModuloRichiesta.astro'
import DisegnoQuotato from './DisegnoQuotato.astro'
import { SITO, type Doc } from '../lib/cms'
import { isMedia, src, urlFile } from '../lib/media'
import { chiaro, piatto } from '../lib/testo'
import { percorso, traduttore } from '../lib/lingua'
import { urlProdotto } from '../lib/catalogo'
import { aggiunteScheda, cleanFighter, righeMisure, specifiche, testiScheda } from '../lib/specifiche'

interface Props {
  p: Doc
  /** Briciole fino alla categoria (la scheda si aggiunge da sola). */
  briciole: { nome: string; url: string }[]
  /** Altri prodotti della stessa categoria, se non ci sono correlati scelti a mano. */
  stessaCategoria?: Doc[]
  tutte?: Doc[]
}
const { p, briciole, stessaCategoria = [], tutte = [] } = Astro.props
const L = Astro.locals.lingua
const t = traduttore(L)
const u = (x?: string) => percorso(L, x)
const qui = urlProdotto(p, tutte)

const d: Doc | null = typeof p.designer === 'object' ? p.designer : null
const galleriaCms: Doc[] = (p.galleria || []).filter((g: Doc) => isMedia(g.immagine))
// 1.07 Colori e foto aggiunti fuori dal CMS (schede-serralunga.json): per ora solo Cubotti Alto.
const campioniCms: Doc[] = (p.campioni || []).filter((c: unknown) => c && typeof c === 'object' && ((c as Doc).hex || isMedia((c as Doc).campione)))
const aggiunte = aggiunteScheda(p, campioniCms, galleriaCms)
const codiceFoto = (g: Doc) => /-[0-9]{3}-[a-z0-9]+$/i.test(String(g.immagine?.filename || '').replace(/\.[a-z0-9]+$/i, ''))
const ultimaColore = galleriaCms.reduce((k, g, i) => (codiceFoto(g) ? i : k), galleriaCms.length - 1)
const galleria: Doc[] = [...galleriaCms.slice(0, ultimaColore + 1), ...aggiunte.galleria, ...galleriaCms.slice(ultimaColore + 1)]
const viste = galleria.length ? galleria.map((g) => g.immagine) : [p.immagine]
const casi: Doc[] = (p.caseHistory || []).filter((c: unknown) => typeof c === 'object')
const correlati: Doc[] = (p.correlati || []).map((c: Doc) => {
  const rel = typeof c.prodotto === 'object' ? c.prodotto : null
  return {
    nome: c.nome || rel?.nome,
    sotto: c.sottotitolo || rel?.etichettaCard,
    immagine: c.immagine || rel?.immagine,
    link: rel?.schedaPubblicata ? u(urlProdotto(rel, tutte)) : u(c.link),
  }
})
const pdf = isMedia(p.disegno?.file) ? urlFile(p.disegno.file) : null
const finiture: Doc[] = (p.finiture || []).filter((f: Doc) => f?.nome)
const codici = finiture.map((f) => f.codice).filter(Boolean)
const MATERIALI: Record<string, string> = { polietilene: t('Polietilene'), moleskin: 'Moleskin', corten: 'Corten', laccato: t('Laccato'), vellutato: t('Vellutato'), decorato: t('Decorato') }
const materiali = (p.materiali || []).map((m: string) => MATERIALI[m] || m)
// Colori scelti dalla cartella colori (collezione "colori"): quadrati 30×30 col colore pieno del campione.
const campioni: Doc[] = [...campioniCms, ...aggiunte.campioni]
// Colori del modulo di richiesta con il codice articolo della variante (WH → 335-WH).
const coloriModulo = campioni.map((c) => ({ ...c, articolo: finiture.find((f) => String(f.codice || '').toUpperCase().endsWith(`-${String(c.codice).toUpperCase()}`))?.codice }))
/*
 * Colore della foto: le foto importate da serralunga.com si chiamano col codice della variante
 * (Cubotti_Alto_Planter_335-WH.jpg, collegata alla variante BIANCO 335-WH). Si cerca nel nome
 * del file il codice articolo più lungo fra le varianti a listino; il nome del colore viene dalla
 * cartella colori quando la parte finale del codice coincide (WH → Bianco), altrimenti dalla variante.
 * Le foto senza codice nel nome (ambientazioni, foto di gruppo) restano senza didascalia.
 */
const nomeFoto = (m: unknown) => {
  if (!isMedia(m)) return ''
  const f = (m as Doc).filename || String(m.url || '').split('?')[0].split('/').pop() || ''
  return decodeURIComponent(f).replace(/\.[a-z0-9]+$/i, '').toUpperCase()
}
const piano = (x: string) => x.toUpperCase().replace(/[^A-Z0-9]+/g, '-')
const campionePer = new Map<string, Doc>(campioni.filter((c) => c.codice).map((c) => [String(c.codice).toUpperCase(), c]))
function coloreDellaFoto(m: unknown): { nome: string; codice: string; hex?: string } | null {
  const file = `-${piano(nomeFoto(m))}-`
  if (file === '--') return null
  const f = finiture
    .filter((x) => x.codice && file.includes(`-${piano(String(x.codice))}-`))
    .sort((a, b) => String(b.codice).length - String(a.codice).length)[0]
  if (!f) return null
  const codice = String(f.codice)
  const c = campionePer.get(codice.split(/[-_\s]/).pop()!.toUpperCase())
  return { nome: c?.nome || f.nome, codice, hex: c?.hex || undefined }
}
const coloriViste = viste.map(coloreDellaFoto)
const conColori = coloriViste.some(Boolean)
const altVista = (v: unknown, k: number) => {
  const c = coloriViste[k]
  if (c) return `${p.nome} — ${c.nome} (${c.codice})`
  return isMedia(v) && v.alt ? undefined : `${p.nome} — ${t('Vista')} ${k + 1}`
}
const q: Doc = p.disegno?.quote || {}
const conQuote = !!q.forma && q.altezza > 0 && (q.diametro > 0 || q.larghezza > 0)
const tondo = q.forma === 'cilindro' || q.forma === 'troncoConico'
const cmq = (v: number) => ({ '@type': 'QuantitativeValue', value: v, unitCode: 'CMT' })
const descrizione = p.seo?.descrizione || piatto(p.descrizione || '').slice(0, 158)

// 1.04 Tendine, icone e domande frequenti.
const scheda = testiScheda(p, L)
const misureScheda = righeMisure(scheda.dimensioni)
const misureLibere = scheda.dimensioni && !misureScheda.length ? scheda.dimensioni : ''
const spec = L === 'it' ? specifiche(p, scheda, campioni) : { icone: [], faq: [] }
const icone = p.scheda?.iconeAutomatiche === false ? [] : spec.icone
const faqManuali: Doc[] = (p.scheda?.faq || []).filter((f: Doc) => f?.domanda && f?.risposta)
const faq = [
  ...faqManuali.map((f, k) => ({ domanda: f.domanda, risposta: f.risposta, campo: `scheda.faq.${k}`, immagine: undefined })),
  ...(p.scheda?.faqAutomatiche === false ? [] : spec.faq.map((f) => ({ ...f, campo: undefined }))),
]
const conDimensioni = misureScheda.length > 0 || !!misureLibere || (p.dimensioni || []).length > 0 || conQuote || isMedia(p.disegno?.immagine)
const tendine = !!(scheda.caratteristiche || icone.length || conDimensioni || scheda.cura || scheda.spedizione || scheda.illuminazione)
const ico = (f: string) => `/specifiche/${f}`
/** Elenchi puntati: una voce per riga; per le Caratteristiche anche una voce per frase. */
const voci = (x?: string, frasi = false) =>
  (x || '')
    .split('\n')
    .flatMap((r) => (frasi && !/^[^:]{2,30}:/.test(r) ? r.split(/(?<=[a-zà-ù0-9%)°C])\.\s+(?=[A-ZÀ-Ú])/) : [r]))
    .map((r) => r.trim().replace(/\.$/, ''))
    .filter(Boolean)
const puntiCar = voci(scheda.caratteristiche, true)
const puntiCura = voci(scheda.cura)

const jsonld = [{
  '@type': 'Product',
  '@id': `${SITO}${u(qui)}#prodotto`,
  name: p.nome,
  url: `${SITO}${u(qui)}`,
  description: piatto(p.descrizione || p.seo?.descrizione || ''),
  brand: { '@type': 'Brand', name: 'Serralunga' },
  manufacturer: { '@id': `${SITO}/#organizzazione` },
  category: p.tipologia || p.categoria,
  image: viste.filter(isMedia).map((m) => src(m, 1800)),
  sku: codici[0],
  material: materiali.length ? materiali.join(', ') : p.specifiche?.find((s: Doc) => /material/i.test(s.etichetta))?.valore,
  ...(campioni.length
    ? { color: campioni.map((c) => `${c.nome} (${c.codice})`).join(', ') }
    : finiture.length > 1 ? { color: finiture.slice(0, 40).map((f) => f.nome).join(', ') } : {}),
  ...(conQuote
    ? {
        height: cmq(q.altezza),
        width: cmq(tondo ? q.diametro : q.larghezza),
        depth: cmq(tondo ? q.diametro : q.profondita || q.larghezza),
        ...(q.peso > 0 ? { weight: { '@type': 'QuantitativeValue', value: q.peso, unitCode: 'KGM' } } : {}),
      }
    : {}),
  ...(d ? { creator: { '@type': 'Person', name: d.nome } } : {}),
}, ...(faq.length
  ? [{
      '@type': 'FAQPage',
      '@id': `${SITO}${u(qui)}#domande`,
      about: { '@id': `${SITO}${u(qui)}#prodotto` },
      inLanguage: L,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: piatto(f.domanda),
        acceptedAnswer: { '@type': 'Answer', text: piatto(f.risposta) },
      })),
    }]
  : [])]
---
<Base
  titolo={p.seo?.titolo || `${p.nome} | Serralunga`}
  descrizione={descrizione}
  immagine={p.seo?.immagine || viste[0]}
  percorso={[...briciole, { nome: p.nome, url: qui }]}
  jsonld={jsonld}
  pagina={`prodotto-${p.slug}`}
  doc={`collections/prodotti/${p.id}`}
  blocchi={p.blocchi ?? []}
>
  <section class="prodotto" id="prodotto-scheda" aria-labelledby="prodotto-titolo">
    <div class="wrap prodotto__griglia">
      <div
        class="galleria"
        data-galleria
        data-intervallo="5000"
        role={viste.length > 1 ? 'region' : undefined}
        aria-roledescription={viste.length > 1 ? t('carosello') : undefined}
        aria-label={t('Foto del prodotto')}
      >
        <div class="galleria__palco" data-palco>
          {viste.map((v, k) => (
            <Img media={v} alt={altVista(v, k)} class={k === 0 ? 'attiva' : ''} priorita={k === 0} sizes="(max-width: 900px) 100vw, 56vw" larghezza={1800} data-vista data-lb="prodotto" data-colore={coloriViste[k] ? `${coloriViste[k]!.nome} · ${coloriViste[k]!.codice}` : undefined} />
          ))}
          {conColori && (
            <p class="galleria__colore" data-colore-attivo aria-live="polite" hidden={!coloriViste[0]}>
              {coloriViste[0] && <><span class="galleria__colore-nome">{coloriViste[0].nome}</span> <span class="galleria__colore-codice">{coloriViste[0].codice}</span></>}
            </p>
          )}
          {isMedia(viste[0]) && (
            <button type="button" class="galleria__zoom" data-zoom aria-label={t('Ingrandisci la foto')}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM15.3 15.3 20 20M10.5 7.5v6M7.5 10.5h6" /></svg>
            </button>
          )}
          {viste.length > 1 && (
            <div class="galleria__comandi">
              <button type="button" data-verso="-1" aria-label={t('Foto precedente')}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M15 5l-7 7 7 7" /></svg></button>
              <span class="galleria__conto" aria-live="polite" data-conto>1 / {viste.length}</span>
              <button type="button" data-verso="1" aria-label={t('Foto successiva')}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M9 5l7 7-7 7" /></svg></button>
              <button type="button" class="galleria__pausa" data-pausa aria-pressed="false" aria-label={t('Ferma lo scorrimento delle foto')} hidden>
                <svg class="ico-pausa" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
                <svg class="ico-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M7 5l12 7-12 7z" /></svg>
              </button>
            </div>
          )}
        </div>
        {viste.length > 1 && (
          <div class:list={['galleria__miniature', conColori && 'galleria__miniature--colori']} data-miniature>
            {viste.map((v, k) => {
              const c = coloriViste[k]
              return (
                <button type="button" data-mini aria-current={k === 0 ? 'true' : 'false'} aria-label={`${t('Vista')} ${k + 1} ${t('di')} ${viste.length}${c ? `: ${c.nome}, ${t('codice')} ${c.codice}` : ''}`}>
                  <span class="galleria__mini-foto"><Img media={v} alt="" sizes="120px" larghezza={400} /></span>
                  {conColori && (
                    <span class="galleria__mini-testo" aria-hidden="true">
                      {c && <span class="galleria__mini-nome">{c.nome}</span>}
                      {c && <span class="galleria__mini-codice">{c.codice}</span>}
                    </span>
                  )}
                </button>
              )
            })}
          </div>
        )}
      </div>

      <div class="prodotto__info">
        <div class="prodotto__testa">
          {(p.categoria || p.tipologia) && <span class="kicker" data-campo={p.categoria ? 'categoria' : 'tipologia'}>{p.categoria || p.tipologia}</span>}
          <h1 class="prodotto__h1" id="prodotto-titolo" data-campo="nome">{p.nome}</h1>
          {(p.firma || d) && <div class="firma-riga"><span>{p.firma || `${t('Disegno di')} ${d?.nome}`}</span></div>}
        </div>
        <Testo class="prodotto__descr" campo="descrizione" t={p.descrizione} />
        {(p.colori || []).length > 0 && (
          <div class="colori">
            <span class="etichetta titolo-spec">{t('Cartella colori')}</span>
            <ul class="colori__elenco">
              {p.colori.map((c: Doc) => (
                <li title={c.nome} class={chiaro(c.hex) ? 'chiaro' : undefined} style={`background:${c.hex}`}><span class="sr-only">{c.nome}</span></li>
              ))}
            </ul>
            {p.notaColori && <span class="colori__nota" data-campo="notaColori">{p.notaColori}</span>}
          </div>
        )}
        {campioni.length > 0 && (
          <div class="campioni" id="prodotto-colori">
            <h2 class="etichetta titolo-spec">{t('Colori disponibili')}</h2>
            <ul class="campioni__elenco">
              {campioni.map((c) => (
                <li class="campioni__voce">
                  <span
                    class:list={['campioni__quadrato', c.hex && chiaro(c.hex) && 'chiaro']}
                    style={c.hex ? `background:${c.hex}` : undefined}
                    aria-hidden="true"
                  >{!c.hex && <Img media={c.campione} alt="" sizes="30px" larghezza={400} />}</span>
                  <span class="campioni__codice">{c.codice}{L === 'it' && cleanFighter(c.codice) === false && <img class="campioni__cf" src={ico('non-clean-fighter.png')} alt="" title="Non Clean Fighter" width="14" height="14" loading="lazy" />}</span>
                  <span class="campioni__nome">{c.nome}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {(materiali.length > 0 || d) && (
          <dl class="misure misure--info">
            {materiali.length > 0 && <div><dt>{t('Materiale e finitura')}</dt><dd>{materiali.join(', ')}</dd></div>}
            {d && <div><dt>{t('Design')}</dt><dd>{d.nome}</dd></div>}
          </dl>
        )}
        {tendine && (
          <div class="tendine" id="prodotto-scheda-tecnica">
            {(scheda.caratteristiche || icone.length > 0) && (
              <details class="tendina" name="scheda-prodotto" id="caratteristiche" open>
                <summary>{t('Caratteristiche')}</summary>
                <div class="tendina__corpo">
                  {puntiCar.length > 1 ? (
                    <ul class="tendina__punti" data-campo-elenco="scheda.caratteristiche">{puntiCar.map((v) => <li>{v}</li>)}</ul>
                  ) : (
                    <Testo class="tendina__testo" campo="scheda.caratteristiche" t={scheda.caratteristiche} />
                  )}
                  {icone.length > 0 && (
                    <ul class="icone-tec" aria-label="Specifiche dal catalogo Serralunga">
                      {icone.map((i) => (
                        <li class="icone-tec__voce">
                          <picture><source srcset={ico(`${i.file}.avif`)} type="image/avif" /><img src={ico(`${i.file}.png`)} alt="" width="50" height="50" loading="lazy" decoding="async" /></picture>
                          <span class="icone-tec__testo">{i.testo}{i.nota && <span class="icone-tec__nota">{i.nota}</span>}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </details>
            )}
            {conDimensioni && (
              <details class="tendina" name="scheda-prodotto" id="disegno">
                <summary>{t('Dimensioni')}</summary>
                <div class="tendina__corpo">
                  {misureScheda.length > 0 && !conQuote && (
                    <dl class="misure">
                      {misureScheda.map((m) => <div><dt>{m.etichetta}</dt><dd>{m.valore}</dd></div>)}
                    </dl>
                  )}
                  {misureLibere && <Testo class="tendina__testo" campo="scheda.dimensioni" t={misureLibere} />}
                  {(p.dimensioni || []).length > 0 && (
                    <dl class="misure">
                      {p.dimensioni.map((m: Doc) => <div><dt>{m.etichetta}</dt><dd>{m.valore}</dd></div>)}
                    </dl>
                  )}
                  {conQuote && <DisegnoQuotato q={q} nome={p.nome} />}
                  {isMedia(p.disegno?.immagine) && (
                    <figure class="tendina__disegno">
                      <Img campo="disegno.immagine" media={p.disegno.immagine} sizes="(max-width: 900px) 100vw, 40vw" larghezza={1800} data-lb="prodotto" />
                      {p.disegno?.testo && <Testo as="figcaption" class="tendina__nota" campo="disegno.testo" t={p.disegno.testo} />}
                    </figure>
                  )}
                </div>
              </details>
            )}
            {scheda.illuminazione && (
              <details class="tendina" name="scheda-prodotto" id="illuminazione">
                <summary>{t('Sistema di illuminazione')}</summary>
                <div class="tendina__corpo"><Testo class="tendina__testo" campo="scheda.illuminazione" t={scheda.illuminazione} /></div>
              </details>
            )}
            {scheda.cura && (
              <details class="tendina" name="scheda-prodotto" id="cura">
                <summary>{t('Istruzioni per la cura')}</summary>
                <div class="tendina__corpo">
                  {puntiCura.length > 1 ? (
                    <ul class="tendina__punti" data-campo-elenco="scheda.cura">{puntiCura.map((v) => <li>{v}</li>)}</ul>
                  ) : (
                    <Testo class="tendina__testo" campo="scheda.cura" t={scheda.cura} />
                  )}
                </div>
              </details>
            )}
            {scheda.spedizione && (
              <details class="tendina" name="scheda-prodotto" id="spedizione">
                <summary>{t('Informazioni sulla spedizione')}</summary>
                <div class="tendina__corpo"><Testo class="tendina__testo" campo="scheda.spedizione" t={scheda.spedizione} /></div>
              </details>
            )}
          </div>
        )}
        <div class="btn-riga">
          <a href="#richiesta" class="btn btn--scuro">{p.pulsante || t('Richiedi scheda e campionatura')}</a>
          {(p.disegno?.immagine || pdf) && <a href={pdf || '#disegno'} class="btn btn--bordo" download={pdf ? '' : undefined} data-apri-tendina={pdf ? undefined : 'disegno'}>{t('Disegno tecnico')}</a>}
        </div>
      </div>
    </div>
  </section>

  {(p.specifiche || []).length > 0 && (
    <section class="specifiche scuro" id="prodotto-specifiche" aria-label={t('Specifiche')}>
      <dl class="wrap">
        {p.specifiche.map((s: Doc) => <div><dt>{s.etichetta}</dt><dd>{s.valore}</dd></div>)}
      </dl>
    </section>
  )}


  {faq.length > 0 && (
    <section class="sez-int pad fondo-chiaro faq-prodotto" id="domande" aria-labelledby="domande-titolo">
      <div class="wrap faq-prodotto__griglia">
        <div class="intesta">
          <span class="kicker">{t('Domande frequenti')}</span>
          <h2 class="titolo titolo--m" id="domande-titolo">{`${p.nome}: ${t('installazione, materiale e manutenzione')}`}</h2>
          <p class="testo testo--s">{t('Risposte tratte dalla documentazione tecnica Serralunga.')}</p>
        </div>
        <div class="faq-prodotto__elenco">
          {faq.map((f, k) => (
            <details class="tendina tendina--faq" name="faq-prodotto" open={k === 0}>
              <summary><h3 class="tendina__domanda" data-campo={f.campo ? `${f.campo}.domanda` : undefined}>{f.domanda}</h3></summary>
              <div class="tendina__corpo">
                <Testo class="tendina__testo" campo={f.campo ? `${f.campo}.risposta` : undefined} t={f.risposta} />
                {f.immagine && (
                  <figure class="tendina__figura">
                    <picture><source srcset={ico(`${f.immagine.file}.avif`)} type="image/avif" /><img src={ico(`${f.immagine.file}.png`)} alt={f.immagine.alt} width={f.immagine.w} height={f.immagine.h} loading="lazy" decoding="async" /></picture>
                    <figcaption class="tendina__nota">{t('Illustrazione dal catalogo Serralunga')}</figcaption>
                  </figure>
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {(isMedia(p.ambiente?.immagineGrande) || (p.ambiente?.immagini || []).length > 0) && (
    <section class="pad ambiente-sez" id="prodotto-ambiente">
      <div class="wrap ambiente">
        <div class="intesta">
          <Testo as="h2" class="titolo titolo--m" campo="ambiente.titolo" t={p.ambiente.titolo} />
          <Testo class="testo testo--s" campo="ambiente.testo" t={p.ambiente.testo} />
        </div>
        {isMedia(p.ambiente.immagineGrande) && <div class="foto r-219"><Img campo="ambiente.immagineGrande" media={p.ambiente.immagineGrande} larghezza={2600} data-lb="prodotto" /></div>}
        {(p.ambiente.immagini || []).length > 0 && (
          <div class="tre-col">
            {p.ambiente.immagini.map((i: Doc) => <div class="foto r-43"><Img media={i.immagine} sizes="(max-width: 900px) 100vw, 33vw" larghezza={1000} data-lb="prodotto" /></div>)}
          </div>
        )}
      </div>
    </section>
  )}

  {d && (
    <section class="sez-int pad scuro" id="prodotto-designer">
      <div class="wrap firma">
        <div>
          {isMedia(d.ritratto) ? (
            <div class="foto foto--scura r-45"><Img media={d.ritratto} sizes="(max-width: 900px) 100vw, 40vw" larghezza={1000} /></div>
          ) : (
            <div class="foto r-45 segnaposto segnaposto--scuro">
              <Img media={d.ritratto} class="ritratto-tondo ritratto-tondo--l" sizes="170px" larghezza={400} />
              <span class="nota-mono">{t('ritratto in alta risoluzione\nda fornire')}</span>
            </div>
          )}
        </div>
        <div class="firma__testi">
          <span class="kicker">{p.firmaProgetto?.kicker || t('La firma del progetto')}</span>
          <h2 class="titolo">{d.nome}</h2>
          {(p.firmaProgetto?.testi || []).map((tx: Doc, k: number) => <Testo class="testo" campo={`firmaProgetto.testi.${k}.testo`} t={tx.testo} />)}
          {(d.numeri || []).length > 0 && (
            <div class="numeri-riga">
              {d.numeri.map((n: Doc) => <div><div class="numeri-riga__valore">{n.valore}</div><div class="etichetta">{n.etichetta}</div></div>)}
            </div>
          )}
          <a href={u(d.schedaPubblicata ? `/designer/${d.slug}/` : '/designer/')} class="btn btn--bordo-chiaro">{d.schedaPubblicata ? `${t('Scheda di')} ${d.nome}` : t('Tutti i designer Serralunga')}</a>
        </div>
      </div>
    </section>
  )}

  {(casi.length > 0 || (p.caseSegnaposto || []).length > 0) && (
    <section id="case" class="sez-int fondo-paper">
      <div class="wrap pad intesta">
        <div class="intesta__sx">
          <span class="kicker">{t('Case history')}</span>
          <Testo as="h2" class="titolo titolo--l" t={t('Dove questo\ndisegno è già di casa')} />
        </div>
        <Frecce rail="rail-case" />
      </div>
      <div class="rail rail--largo" id="rail-case" tabindex="0" aria-label={t('Case history')}>
        {casi.map((c) => <CardCase c={c} />)}
        {(p.caseSegnaposto || []).map((s: Doc) => <CardCase segnaposto={s} />)}
      </div>
    </section>
  )}

  {correlati.length === 0 && stessaCategoria.length > 0 && (
    <section class="sez-int pad fondo-chiaro" id="prodotto-stessa-categoria">
      <div class="wrap">
        <div class="intesta">
          <h2 class="titolo titolo--l">{t('Nella stessa categoria')}</h2>
          {briciole.length > 1 && <a class="btn btn--bordo" href={u(briciole[briciole.length - 1].url)}>{`${t('Tutto in')} ${briciole[briciole.length - 1].nome}`}</a>}
        </div>
        <div class="griglia-4 catalogo__griglia--4">
          {stessaCategoria.slice(0, 4).map((x) => <CardProdotto p={x} tutte={tutte} />)}
        </div>
      </div>
    </section>
  )}

  {correlati.length > 0 && (
    <section class="sez-int pad fondo-chiaro" id="prodotto-correlati">
      <div class="wrap">
        <div class="intesta">
          <h2 class="titolo titolo--l">{t('Prodotti correlati')}</h2>
          <Testo class="testo testo--s" campo="correlatiTesto" t={p.correlatiTesto} />
        </div>
        <div class="griglia-4">
          {correlati.map((c) => {
            const Tag = c.link ? 'a' : 'div'
            return (
              <Tag href={c.link} class="card">
                <div class="foto r-11 zoom"><Img media={c.immagine} sizes="(max-width: 560px) 100vw, 25vw" larghezza={1000} /></div>
                <div>
                  <div class="card__nome card__nome--s">{c.nome}</div>
                  {c.sotto && <div class="card__sotto">{c.sotto}</div>}
                </div>
              </Tag>
            )
          })}
        </div>
      </div>
    </section>
  )}

  <section id="richiesta" class="fascia-finale">
    <Img campo="richiesta.immagine" media={p.richiesta?.immagine || p.immagine} larghezza={2600} />
    <div class="fascia-finale__dentro">
      <div class="centro centro--s">
        <span class="kicker kicker--largo">{p.richiesta?.kicker || t('Documentazione contract')}</span>
        <Testo as="h2" class="titolo" campo="richiesta.titolo" t={p.richiesta?.titolo || t('Scheda tecnica,\ndisegni e campioni')} />
        <Testo class="testo" campo="richiesta.testo" t={p.richiesta?.testo} />
        <ModuloRichiesta colori={aggiunte.moduloColori ? coloriModulo : undefined} richieste={aggiunte.moduloColori} pulsante={t('Richiedi informazioni')} pagina={`${t('Richiesta')}: ${p.nome}${codici[0] ? ` (${codici[0]})` : ''} — ${qui}`} />
      </div>
    </div>
  </section>
  <script>
    // Il pulsante "Disegno tecnico" e i link #disegno, #cura… aprono la tendina corrispondente.
    const apri = (id: string) => {
      const el = document.getElementById(id)
      if (el instanceof HTMLDetailsElement) { el.open = true; el.scrollIntoView({ behavior: 'smooth', block: 'start' }) }
    }
    document.querySelectorAll<HTMLElement>('[data-apri-tendina]').forEach((b) =>
      b.addEventListener('click', (e) => { e.preventDefault(); apri(b.dataset.apriTendina!) }),
    )
    if (location.hash.length > 1) apri(decodeURIComponent(location.hash.slice(1)))
  </script>
</Base>
