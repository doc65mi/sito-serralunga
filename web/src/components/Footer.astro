---
/**
 * Footer unico di tutto il sito, home compresa (Version: 2.02): marchio, colonne di link,
 * contatti, iscrizione alla newsletter (finestra), riga legale e «Gestisci preferenze cookie»
 * (sempre presente: riapre il pannello della CMP). Si cambia nel pannello: Impostazioni del sito > Footer.
 */
import { isMedia, originale, src, tipoRidotte } from '../lib/media'
import { esterno } from '../lib/testo'
import type { Doc } from '../lib/cms'
import { percorso, traduttore } from '../lib/lingua'
import { moduli } from '../lib/moduli'
import ModuloNewsletter from './ModuloNewsletter.astro'
interface Props { imp: Doc }
const { imp } = Astro.props
const L = Astro.locals.lingua
const t = traduttore(L)
const u = (p?: string) => percorso(L, p)
const a = imp.azienda || {}
const logo = isMedia(imp.logo) ? imp.logo : null
const logoAvif = logo && tipoRidotte(logo) === 'image/avif' ? src(logo, 400) : ''
const nome = imp.nomeSito || 'Serralunga'
const copyright = (imp.copyright || '© {anno} Serralunga').replace('{anno}', String(new Date().getFullYear()))
const tel = (a.telefono || '').replace(/[^+\d]/g, '')
const m = await moduli(L)
const newsletter = m.newsletterAttiva !== false
const fuori = (link?: string) => (esterno(link) ? { target: '_blank', rel: 'noopener' } : {})
---
<footer class="piede">
  <div class="piede__griglia">
    <div class="piede__marchio">
      {logo ? (
        <picture>
          {logoAvif && <source srcset={logoAvif} type="image/avif" />}
          <img src={originale(logo)} alt={nome} width={logo.width} height={logo.height} loading="lazy" decoding="async" />
        </picture>
      ) : <span class="logo__testo">{nome}</span>}
      {imp.descrizione && <p>{imp.descrizione}</p>}
      {newsletter && (
        <a class="piede__newsletter" href={u('/newsletter/')} data-apri-newsletter aria-haspopup="dialog">
          {m.testi.newsletterLink} <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
    {(imp.colonne || []).map((c: Doc) => (
      <nav class="piede__col" aria-label={c.titolo}>
        <span class="piede__titolo">{c.titolo}</span>
        {(c.link || []).map((l: Doc) => <a href={u(l.link) || '#'} {...fuori(l.link)}>{l.etichetta}</a>)}
      </nav>
    ))}
    <address class="piede__col">
      <span class="piede__titolo">{t('Contatti')}</span>
      <span>{a.ragioneSociale} — {a.indirizzo}<br />{a.cap} {a.citta}, {a.paese}</span>
      {a.email && <a href={`mailto:${a.email}`}>{a.email}</a>}
      {a.telefono && <a href={`tel:${tel}`}>{a.telefono}</a>}
      {a.piva && <span>{t('P.IVA')} {a.piva}</span>}
    </address>
  </div>
  <div class="piede__fondo">
    <span>{copyright}</span>
    <span class="piede__legali">
      {(imp.legali || []).map((l: Doc) => (l.link ? <a href={u(l.link)}>{l.etichetta}</a> : <span>{l.etichetta}</span>))}
      <button type="button" class="piede__pulsante" data-cookie-preferenze aria-haspopup="dialog">{t('Gestisci preferenze cookie')}</button>
    </span>
  </div>
</footer>
{newsletter && (
  <dialog class="finestra" data-finestra-newsletter aria-labelledby="nl-titolo">
    <div class="finestra__corpo">
      <button type="button" class="finestra__chiudi" data-chiudi aria-label={t('Chiudi')}>×</button>
      <ModuloNewsletter fonte={`Footer — ${Astro.url.pathname}`} idTitolo="nl-titolo" />
    </div>
  </dialog>
)}
