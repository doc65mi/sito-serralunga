---
import { isMedia, urlFile } from '../lib/media'
import { esterno } from '../lib/testo'
import type { Doc } from '../lib/cms'
import { INFO, LINGUE, percorso, traduttore } from '../lib/lingua'
interface Props { imp: Doc; corrente?: string }
const { imp, corrente = '' } = Astro.props
const logo = isMedia(imp.logo) ? imp.logo : null
const L = Astro.locals.lingua
const t = traduttore(L)
const u = (p?: string) => percorso(L, p)
const attivo = (link: string) => !!link && !link.includes('#') && link !== '/' && corrente.startsWith(link)
---
<header class="header" data-header>
  <a href={u('/')} class="logo" aria-label={`${imp.nomeSito || 'Serralunga'}, home`}>
    {logo ? <img src={urlFile(logo)} alt={imp.nomeSito || 'Serralunga'} width={logo.width} height={logo.height} /> : <span class="logo__testo">{imp.nomeSito || 'Serralunga'}</span>}
  </a>
  <button type="button" class="menu-apri" aria-expanded="false" aria-controls="menu-principale" data-menu>{t('Menu')}</button>
  <nav class="nav" id="menu-principale" aria-label={t('Menu principale')}>
    {(imp.menu || []).map((v: Doc) => (
      <a
        href={u(v.link) || '#'}
        class:list={[v.evidenza && 'evidenza']}
        aria-current={attivo(v.link) ? 'page' : undefined}
        target={esterno(v.link) ? '_blank' : undefined}
        rel={esterno(v.link) ? 'noopener' : undefined}
      >{v.etichetta}</a>
    ))}
    <span class="lingue" aria-label={t('Cambia lingua')} role="group">
      {LINGUE.map((l) => (
        l === L
          ? <span aria-current="true" lang={INFO[l].html}>{INFO[l].sigla}</span>
          : <a href={percorso(l, corrente)} hreflang={INFO[l].html} lang={INFO[l].html} title={INFO[l].nome}>{INFO[l].sigla}</a>
      ))}
    </span>
  </nav>
</header>
