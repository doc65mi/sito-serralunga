---
/**
 * Version: 1.00
 * Banner dei cookie: compare solo se è attivo un codice di statistica o marketing e finché il
 * visitatore non sceglie. «Rifiuta» e «Accetta tutti» hanno lo stesso peso; «Personalizza»
 * apre le categorie. La scelta si riapre da «Preferenze cookie» nel footer.
 */
import type { Doc } from '../lib/cms'
import { percorso, traduttore } from '../lib/lingua'
import { TESTI_MODULI } from '../lib/moduli'
import { tracciamentoAttivo } from '../lib/tracciamento'
interface Props { imp: Doc }
const { imp } = Astro.props
const L = Astro.locals.lingua
const t = traduttore(L)
const testo = (typeof imp.cookieTesto === 'string' && imp.cookieTesto.trim()) || TESTI_MODULI[L].cookieTesto
const link = imp.cookieLink ? percorso(L, imp.cookieLink) : ''
---
{tracciamentoAttivo(imp) && (
  <section class="cookie" data-banner-cookie hidden aria-labelledby="cookie-titolo" role="region">
    <h2 class="cookie__titolo" id="cookie-titolo">{t('Preferenze cookie')}</h2>
    <p>{testo}{link && <> <a href={link}>{t('Cookie policy')}</a></>}</p>
    <div class="cookie__scelte" data-cookie-scelte hidden>
      <label><input type="checkbox" checked disabled /> {t('Necessari')}</label>
      <label><input type="checkbox" data-categoria="statistiche" /> {t('Statistiche')}</label>
      <label><input type="checkbox" data-categoria="marketing" /> {t('Marketing')}</label>
    </div>
    <div class="cookie__pulsanti">
      <button type="button" data-cookie="rifiuta">{t('Rifiuta')}</button>
      <button type="button" data-cookie="personalizza">{t('Personalizza')}</button>
      <button type="button" data-cookie="salva" hidden>{t('Salva le scelte')}</button>
      <button type="button" data-cookie="tutti">{t('Accetta tutti')}</button>
    </div>
  </section>
)}
