---
/** Modulo "Richiedi il volume" (template: Home v2 #listino). Invia a /api/richiesta, che salva in Payload. */
import { impostazioni } from '../lib/cms'
import { traduttore } from '../lib/lingua'
interface Props { pulsante?: string; grazie?: string; pagina?: string }
const L = Astro.locals.lingua
const t = traduttore(L)
const { pulsante = t('Richiedi il volume'), grazie, pagina = '' } = Astro.props
const imp = await impostazioni(L)
const email = imp.azienda?.email || 'info@serralunga.com'
---
<form class="modulo" method="post" action="/api/richiesta" data-richiesta data-grazie={grazie || t('Grazie, vi ricontatteremo a breve.')} data-email={email} data-invio={t('Invio in corso…')} data-errore={t('Invio non riuscito')} data-anche={t('Potete scriverci anche a')}>
  <div class="modulo__campi">
    <label><span class="sr-only">{t('Struttura o studio')}</span><input type="text" name="struttura" placeholder={t('Struttura o studio')} autocomplete="organization" maxlength="200" /></label>
    <label><span class="sr-only">{t('Referente')}</span><input type="text" name="referente" placeholder={t('Referente')} autocomplete="name" maxlength="200" /></label>
    <label><span class="sr-only">{t('Email (obbligatoria)')}</span><input type="email" name="email" placeholder={t('Email')} autocomplete="email" required maxlength="200" /></label>
    <label><span class="sr-only">{t('Città del progetto')}</span><input type="text" name="citta" placeholder={t('Città del progetto')} autocomplete="address-level2" maxlength="200" /></label>
  </div>
  <label class="modulo__trappola" aria-hidden="true">{t('Non compilare')}<input type="text" name="sito_web" tabindex="-1" autocomplete="off" /></label>
  <input type="hidden" name="pagina" value={L === 'it' ? pagina : `${pagina} (${L.toUpperCase()})`} />
  <input type="hidden" name="lingua" value={L} />
  <button type="submit" class="btn btn--chiaro">{pulsante}</button>
  <p class="modulo__esito" data-esito role="status" aria-live="polite"></p>
  <p class="modulo__privacy">{t('Usiamo questi dati solo per rispondere alla richiesta. Scrivici a')} <a href={`mailto:${email}`}>{email}</a> {t('per cancellarli.')}</p>
</form>
