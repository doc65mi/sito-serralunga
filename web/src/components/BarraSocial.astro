---
/**
 * Barra social laterale (Version: 1.01): nera semitrasparente, a destra, a metà altezza.
 * 1.01: in fondo la lente della ricerca, su fondo #595858 per separarla dalle icone social.
 * Solo su schermi larghi e solo se in Impostazioni > Social e barra mobile la posizione è «barra» o «entrambi».
 * Sui telefoni gli stessi profili stanno nel pulsante «Social» della barra in basso.
 */
import Icona from './Icona.astro'
import type { Doc } from '../lib/cms'
import { posizioneSocial, socialAttivi } from '../lib/social'
import { percorso, traduttore } from '../lib/lingua'
interface Props { imp: Doc }
const { imp } = Astro.props
const t = traduttore(Astro.locals.lingua)
// La lente c'è sempre; le icone social solo se la posizione scelta è «barra» o «entrambi».
const profili = ['barra', 'entrambi'].includes(posizioneSocial(imp)) ? socialAttivi(imp) : []
---
<aside class="barra-social" aria-label={t('Social e ricerca')}>
    <ul>
      {profili.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener noreferrer me" aria-label={`${s.nome} (${t('si apre in una nuova finestra')})`} title={s.nome}>
            <Icona nome={s.rete} dim={20} />
          </a>
        </li>
      ))}
      <li class="barra-social__cerca">
        <a href={percorso(Astro.locals.lingua, '/cerca/')} data-cerca-apri aria-haspopup="dialog" aria-label={t('Cerca nel sito')} title={t('Cerca nel sito')}>
          <Icona nome="cerca" dim={20} />
        </a>
      </li>
    </ul>
  </aside>
