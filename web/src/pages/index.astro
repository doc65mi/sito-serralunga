---
/** Home — template: template/Serralunga Contract Home v2.dc.html (slide) e v3 (video). */
import Base from '../layouts/Base.astro'
import Img from '../components/Img.astro'
import Testo from '../components/Testo.astro'
import Frecce from '../components/Frecce.astro'
import CardDesigner from '../components/CardDesigner.astro'
import CardProdotto from '../components/CardProdotto.astro'
import ModuloRichiesta from '../components/ModuloRichiesta.astro'
import { globale, type Doc } from '../lib/cms'
import { isMedia, urlFile } from '../lib/media'
import { piatto } from '../lib/testo'

const h = await globale('home', 2)
const slide: Doc[] = h.slide || []
const video = h.video || {}
const designer: Doc[] = (h.designer?.elenco || []).filter((d: unknown) => typeof d === 'object')
const segnaposto = Array.from({ length: h.designer?.segnaposto || 0 })
const prodotti: Doc[] = (h.portfolio?.prodotti || []).filter((p: unknown) => typeof p === 'object')
const usaVideo = h.tipoApertura === 'video'
---
<Base
  titolo={h.seo?.titolo || h.h1}
  descrizione={h.seo?.descrizione}
  immagine={h.seo?.immagine || slide[0]?.immagine}
  pagina="home"
>
  {usaVideo ? (
    <section class="hero-video" id="home-apertura" aria-label="Apertura">
      <Img media={video.poster} priorita larghezza={2600} />
      {isMedia(video.file) && (
        <video id="hero-video" autoplay muted loop playsinline poster={isMedia(video.poster) ? urlFile(video.poster) : undefined}>
          <source src={urlFile(video.file)} type={video.file.mimeType || 'video/mp4'} />
        </video>
      )}
      <div class="velo velo--hero"></div>
      <div class="hero-video__testi">
        {video.kicker && <span class="kicker kicker--largo kicker--chiaro">{video.kicker}</span>}
        <Testo as="h1" class="titolo-schermo" t={video.titolo || h.h1} />
        <div class="riga-base">
          <Testo t={video.testo} />
          <div class="hero-video__azioni">
            {video.linkEtichetta && <a href={video.link || '#luoghi'} class="btn btn--bordo-chiaro">{video.linkEtichetta}</a>}
            {isMedia(video.file) && <button type="button" class="btn-play" data-play="hero-video" aria-label="Play o pausa del video">II</button>}
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="hero" id="home-apertura" aria-roledescription="carosello" aria-label="Apertura" data-hero>
      <div class="hero__wrap">
        <h1 class="sr-only">{piatto(h.h1)}</h1>
        <div class="hero__palco">
          {slide.map((s, k) => (
            <div class:list={['hero__slide', k === 0 && 'attiva']} data-slide aria-hidden={k === 0 ? 'false' : 'true'} aria-roledescription="slide" aria-label={`${k + 1} di ${slide.length}`}>
              <div class="hero__foto"><Img media={s.immagine} priorita={k === 0} larghezza={2600} sizes="(max-width: 800px) 100vw, 78vw" /></div>
              <div class="hero__box">
                {s.kicker && <span class="kicker">{s.kicker}</span>}
                <Testo as="div" class="hero__titolo" t={s.titolo} />
                <Testo t={s.testo} />
                {s.linkEtichetta && <a href={s.link || '#luoghi'} class="link-freccia">{s.linkEtichetta}</a>}
              </div>
            </div>
          ))}
        </div>
        {slide.length > 1 && (
          <div class="hero__comandi">
            <div class="hero__punti">
              {slide.map((_, k) => (
                <button type="button" class="hero__punto" data-vai aria-current={k === 0 ? 'true' : 'false'} aria-label={`Immagine ${k + 1}`}></button>
              ))}
              <span class="hero__conta"><span data-conta>01</span> / {String(slide.length).padStart(2, '0')}</span>
            </div>
            <div class="frecce">
              <button type="button" class="freccia" data-prec aria-label="Precedente">←</button>
              <button type="button" class="freccia" data-succ aria-label="Successiva">→</button>
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  {h.manifesto?.testo && (
    <section id="manifesto" class="manifesto fondo-paper" aria-label={h.manifesto.kicker || 'Il nostro sguardo'}>
      <div class="manifesto__dentro" data-reveal>
        {h.manifesto.kicker && <span class="kicker">{h.manifesto.kicker}</span>}
        <Testo t={h.manifesto.testo} />
        <span class="manifesto__filo"></span>
      </div>
    </section>
  )}

  {(h.luoghi || []).length > 0 && (
    <section id="luoghi" class="luoghi fondo-paper" aria-label="I luoghi">
      {h.luoghi.map((c: Doc, k: number) => (
        <div class:list={['capitolo', k % 2 === 1 && 'capitolo--inverso']} data-reveal>
          <div class="foto foto--sand capitolo__foto"><Img media={c.immagine} sizes="(max-width: 900px) 100vw, 55vw" larghezza={1800} /></div>
          <div class="capitolo__testi">
            {c.numero && <span class="numero-romano" aria-hidden="true">{c.numero}</span>}
            {c.kicker && <span class="kicker">{c.kicker}</span>}
            <Testo as="h2" class="titolo titolo--xl" t={c.titolo} />
            <Testo class="testo" t={c.testo} />
            {c.didascalia && <span class="didascalia">{c.didascalia}</span>}
          </div>
        </div>
      ))}
    </section>
  )}

  {h.banner?.titolo && (
    <section class="banner" id="home-banner" aria-label={piatto(h.banner.titolo)}>
      <Img media={h.banner.immagine} larghezza={2600} />
      <div class="velo velo--banner"></div>
      <div class="banner__testi">
        <div class="banner__sx">
          {h.banner.numero && <span class="numero-romano" aria-hidden="true">{h.banner.numero}</span>}
          {h.banner.kicker && <span class="kicker">{h.banner.kicker}</span>}
          <Testo as="h2" class="banner__titolo" t={h.banner.titolo} />
        </div>
        <Testo t={h.banner.testo} />
      </div>
    </section>
  )}

  {h.materia?.titolo && (
    <section id="materia" class="materia scuro">
      <div class="wrap materia__dentro">
        <div class="due-col" data-reveal>
          <div class="due-col__sx">
            {h.materia.kicker && <span class="kicker">{h.materia.kicker}</span>}
            <Testo as="h2" class="titolo" t={h.materia.titolo} />
          </div>
          <Testo class="testo" t={h.materia.testo} />
        </div>
        {(h.materia.schede || []).length > 0 && (
          <div class="tre-col" data-reveal>
            {h.materia.schede.map((s: Doc) => (
              <div class="scheda-materia">
                <div class="foto foto--scura r-45"><Img media={s.immagine} sizes="(max-width: 900px) 100vw, 33vw" larghezza={1000} /></div>
                <div>
                  <h3>{s.titolo}</h3>
                  <Testo t={s.testo} />
                </div>
              </div>
            ))}
          </div>
        )}
        {(h.materia.numeri || []).length > 0 && (
          <div class="cifre">
            {h.materia.numeri.map((n: Doc) => (
              <div><div class="cifra__valore">{n.valore}</div><div class="cifra__etichetta">{n.etichetta}</div></div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {(designer.length > 0 || segnaposto.length > 0) && (
    <section id="designer" class="sez fondo-paper">
      <div class="wrap pad intesta" data-reveal>
        <div class="intesta__sx">
          {h.designer.kicker && <span class="kicker">{h.designer.kicker}</span>}
          <Testo as="h2" class="titolo titolo--xl" t={h.designer.titolo} />
        </div>
        <div class="intesta__dx">
          <Testo class="testo" t={h.designer.testo} />
          <Frecce rail="rail-designer" />
        </div>
      </div>
      <div class="rail" id="rail-designer" tabindex="0" aria-label="Designer">
        {designer.map((d) => <CardDesigner d={d} home link={d.schedaPubblicata} />)}
        {segnaposto.map(() => <CardDesigner home />)}
      </div>
    </section>
  )}

  {(h.collezioni?.tessere || []).length > 0 && (
    <section id="collezioni" class="sez pad fondo-paper">
      <div class="wrap">
        <div class="intesta" data-reveal>
          <Testo as="h2" class="titolo titolo--xl" t={h.collezioni.titolo} />
          <Testo class="testo" t={h.collezioni.testo} />
        </div>
        <div class="tessere" data-reveal>
          {h.collezioni.tessere.map((t: Doc) => (
            <a href={t.link || '#invito'} class="tessera">
              <Img media={t.immagine} sizes="(max-width: 560px) 100vw, (max-width: 1100px) 50vw, 25vw" larghezza={1000} />
              <span>{t.etichetta}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {prodotti.length > 0 && (
    <section id="portfolio" class="sez pad fondo-chiaro">
      <div class="wrap">
        <div class="intesta" data-reveal>
          <div class="intesta__sx">
            {h.portfolio.kicker && <span class="kicker">{h.portfolio.kicker}</span>}
            <Testo as="h2" class="titolo titolo--xl" t={h.portfolio.titolo} />
          </div>
          <Testo class="testo" t={h.portfolio.testo} />
        </div>
        <div class="griglia-3" data-reveal>
          {prodotti.map((p) => <CardProdotto p={p} ancoraRichiesta="#invito" />)}
        </div>
      </div>
    </section>
  )}

  {h.citazione?.testo && (
    <section class="sez pad fondo-paper" id="home-citazione" aria-label="Citazione">
      <div class="citazione" data-reveal>
        <div class="foto foto--sand r-11"><Img media={h.citazione.immagine} sizes="(max-width: 800px) 100vw, 50vw" larghezza={1000} /></div>
        <blockquote>
          <Testo t={h.citazione.testo} />
          {h.citazione.firma && <span class="kicker">{h.citazione.firma}</span>}
        </blockquote>
      </div>
    </section>
  )}

  <section id="invito" class="invito">
    <Img media={h.invito?.immagine} larghezza={2600} />
    <div class="invito__dentro">
      <div class="centro">
        {h.invito?.kicker && <span class="kicker kicker--largo">{h.invito.kicker}</span>}
        <Testo as="h2" class="titolo" t={h.invito?.titolo} />
        <Testo class="testo" t={h.invito?.testo} />
        <ModuloRichiesta pulsante={h.invito?.pulsante} grazie={h.invito?.grazie} pagina="Home" />
      </div>
    </div>
  </section>
</Base>
