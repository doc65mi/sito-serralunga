---
import Base from '../layouts/Base.astro'
import Testo from '../components/Testo.astro'
import { percorso, traduttore } from '../lib/lingua'
Astro.response.status = 404
const L = Astro.locals.lingua
const t = traduttore(L)
---
<Base titolo={t('Pagina non trovata | Serralunga')} descrizione={t('La pagina cercata non esiste o è stata spostata.')}>
  <section class="sez pad fondo-paper vuoto">
    <div class="centro centro--s">
      <span class="kicker">{t('Errore 404')}</span>
      <Testo as="h1" class="titolo titolo--xl" t={t('Questa pagina\nnon c’è più')} />
      <p class="testo">{t('Forse è stata spostata. Riparti dalla home o scopri i nostri designer.')}</p>
      <div class="btn-riga btn-riga--centro">
        <a href={percorso(L, '/')} class="btn btn--scuro">{t('Torna alla home')}</a>
        <a href={percorso(L, '/designer/')} class="btn btn--bordo">{t('I designer')}</a>
      </div>
    </div>
  </section>
</Base>
