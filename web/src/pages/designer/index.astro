---
/** Elenco designer — template: template/Designer.dc.html */
import Base from '../../layouts/Base.astro'
import Testo from '../../components/Testo.astro'
import CardDesigner from '../../components/CardDesigner.astro'
import { elenco, globale } from '../../lib/cms'
import { piatto } from '../../lib/testo'
import { percorso, traduttore } from '../../lib/lingua'

const L = Astro.locals.lingua
const t = traduttore(L)
const u = (p?: string) => percorso(L, p)
const pagina = await globale('pagina-designer', 2, L)
const designer = await elenco('designer', { depth: 1 }, L)
const segnaposto = Array.from({ length: pagina.segnaposto || 0 })
---
<Base
  titolo={pagina.seo?.titolo || `${piatto(pagina.titolo)} | Serralunga`}
  descrizione={pagina.seo?.descrizione}
  immagine={pagina.seo?.immagine}
  percorso={[{ nome: t('I designer'), url: '/designer/' }]}
  pagina="designer"
  doc="globals/pagina-designer"
  blocchi={pagina.blocchi ?? []}
>
  <section class="intro-pagina" id="designer-intro">
    <div class="wrap intro-pagina__griglia">
      <div>
        {pagina.kicker && <span class="kicker" data-campo="kicker">{pagina.kicker}</span>}
        <Testo as="h1" class="titolo titolo--display" campo="titolo" t={pagina.titolo} />
      </div>
      <Testo class="testo" campo="testo" t={pagina.testo} />
    </div>
  </section>

  <section class="pad ambiente-sez" id="designer-elenco" aria-label={t('Elenco dei designer')}>
    <div class="wrap elenco-designer">
      {designer.map((d) => <CardDesigner d={d} link />)}
      {segnaposto.map(() => <CardDesigner />)}
    </div>
  </section>

  <section id="richiesta" class="sez-int pad scuro">
    <div class="centro centro--s">
      {pagina.cta?.kicker && <span class="kicker kicker--largo" data-campo="cta.kicker">{pagina.cta.kicker}</span>}
      <Testo as="h2" class="titolo titolo--cta" campo="cta.titolo" t={pagina.cta?.titolo} />
      <Testo class="testo" campo="cta.testo" t={pagina.cta?.testo} />
      {pagina.cta?.pulsante && <a href={u(pagina.cta.link || '/#listino')} class="btn btn--chiaro" data-campo="cta.pulsante" data-campo-link="cta.link" data-link={pagina.cta.link || ''}>{pagina.cta.pulsante}</a>}
    </div>
  </section>
</Base>
