---
/** Scheda designer — template: template/Designer - Marc Sadler.dc.html */
import Base from '../../layouts/Base.astro'
import Img from '../../components/Img.astro'
import Testo from '../../components/Testo.astro'
import Frecce from '../../components/Frecce.astro'
import CardProdotto from '../../components/CardProdotto.astro'
import { elenco, perSlug, type Doc } from '../../lib/cms'
import { isMedia, src } from '../../lib/media'
import { piatto } from '../../lib/testo'
import { percorso, traduttore } from '../../lib/lingua'

const L = Astro.locals.lingua
const t = traduttore(L)
const u = (p?: string) => percorso(L, p)
const d = await perSlug('designer', Astro.params.slug || '', 2, L)
if (!d || !d.schedaPubblicata) return Astro.rewrite('/404')

const pezzi = await elenco('prodotti', { 'where[designer][equals]': d.id, depth: 1 }, L)
const segnaposto = Array.from({ length: d.pezziSegnaposto || 0 })
const creazioni: Doc[] = (d.creazioni || []).filter((c: Doc) => isMedia(c.immagine))

const jsonld = [{
  '@type': 'Person',
  name: d.nome,
  jobTitle: d.ruolo,
  description: piatto(d.seo?.descrizione || d.estratto),
  image: isMedia(d.ritratto) ? src(d.ritratto, 1000) : undefined,
  award: (d.premi || []).map((p: Doc) => `${p.titolo} ${p.anno}`),
}]
---
<Base
  titolo={d.seo?.titolo || `${d.nome} | Serralunga`}
  descrizione={d.seo?.descrizione || d.estratto}
  immagine={d.seo?.immagine || d.ritratto}
  percorso={[{ nome: t('I designer'), url: '/designer/' }, { nome: d.nome, url: `/designer/${d.slug}/` }]}
  jsonld={jsonld}
  pagina={`designer-${d.slug}`}
  doc={`collections/designer/${d.id}`}
  blocchi={d.blocchi ?? []}
>
  <section class="bio" id="designer-bio">
    <div class="wrap bio__griglia">
      {isMedia(d.ritratto) ? (
        <div class="foto r-34 bio__ritratto"><Img campo="ritratto" media={d.ritratto} priorita sizes="(max-width: 900px) 100vw, 40vw" larghezza={1000} /></div>
      ) : (
        <div class="foto r-34 segnaposto bio__ritratto">
          <Img campo="ritratto" media={d.ritratto} class="ritratto-tondo ritratto-tondo--xl" priorita sizes="180px" larghezza={400} />
          <span class="nota-mono">{t('ritratto in alta risoluzione\nda fornire')}</span>
        </div>
      )}
      <div class="bio__testi">
        {d.provenienza && <span class="kicker" data-campo="provenienza">{d.provenienza}</span>}
        <h1 data-campo="nome">{d.nome}</h1>
        <Testo class="bio__citazione" campo="citazione" t={d.citazione} />
        {(d.biografia || []).map((p: Doc, k: number) => <Testo class="testo" campo={`biografia.${k}.testo`} t={p.testo} />)}
        {(d.numeri || []).length > 0 && (
          <div class="numeri-riga">
            {d.numeri.map((n: Doc) => <div><div class="numeri-riga__valore">{n.valore}</div><div class="etichetta">{n.etichetta}</div></div>)}
          </div>
        )}
        {(d.premi || []).length > 0 && (
          <ul class="premi" aria-label={t('Premi e riconoscimenti')}>
            {d.premi.map((p: Doc) => <li><span>{p.anno}</span><span>{p.titolo}</span></li>)}
          </ul>
        )}
      </div>
    </div>
  </section>

  {d.banner?.frase && (
    <section class="banner-frase" id="designer-banner" aria-label={t('Fotografia')}>
      <Img campo="banner.immagine" media={d.banner.immagine} larghezza={2600} />
      <div class="velo velo--banner"></div>
      <Testo campo="banner.frase" t={d.banner.frase} />
    </section>
  )}

  {creazioni.length > 0 && (
    <section class="sez-creazioni pad" id="designer-creazioni" aria-labelledby="designer-creazioni-titolo">
      <div class="wrap">
        <div class="intesta">
          <h2 class="titolo titolo--l" id="designer-creazioni-titolo">{t('Le creazioni per Serralunga')}</h2>
          <p class="testo">{t('Foto di prodotto e ambientate dal catalogo Serralunga.')}</p>
        </div>
        <div class="creazioni">
          {creazioni.map((c, k) => (
            <figure class:list={['creazione', c.ambientata && 'creazione--ambientata']}>
              <div class:list={['foto', c.ambientata ? 'r-43' : 'r-11 foto--prodotto']}>
                <Img campo={`creazioni.${k}.immagine`} media={c.immagine} sizes={c.ambientata ? '(max-width: 700px) 100vw, 50vw' : '(max-width: 700px) 50vw, 25vw'} larghezza={c.ambientata ? 1800 : 1000} />
              </div>
              <figcaption>
                <span class="creazione__nome" data-campo={`creazioni.${k}.nome`}>{c.nome}</span>
                {c.tipo && <span class="creazione__tipo" data-campo={`creazioni.${k}.tipo`}>{c.tipo}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {(pezzi.length > 0 || segnaposto.length > 0) && (
    <section class="sez-pezzi" id="designer-pezzi">
      <div class="wrap pad intesta">
        <Testo as="h2" class="titolo titolo--l" campo="titoloPezzi" t={d.titoloPezzi || t('I pezzi\nper Serralunga')} />
        <Frecce rail="rail-opere" />
      </div>
      <div class="rail" id="rail-opere" tabindex="0" aria-label={`${t('Pezzi di')} ${d.nome}`}>
        {pezzi.map((p) => <CardProdotto p={p} sotto={p.categoria?.split('—')[0]?.trim() || p.etichettaCard} />)}
        {segnaposto.map(() => (
          <div class="card card--vuota">
            <div class="foto r-45 segnaposto"><span class="nota-mono">{t('altri pezzi\nda confermare')}</span></div>
            <div class="card__piede"><div><div class="card__nome">{t('Nome prodotto')}</div><div class="card__sotto">{t('Collezione')}</div></div></div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="sez-int pad scuro" id="designer-cta">
    <div class="centro centro--s">
      <span class="kicker kicker--largo">{d.cta?.kicker || t('Progetti su misura')}</span>
      <Testo as="h2" class="titolo titolo--cta" campo="cta.titolo" t={d.cta?.titolo || t('Lavoriamo con i designer,\nper il vostro luogo')} />
      <div class="btn-riga btn-riga--centro">
        <a href={u('/#listino')} class="btn btn--chiaro">{t('Parliamo del progetto')}</a>
        <a href={u('/designer/')} class="btn btn--bordo-chiaro">{t('Tutti i designer')}</a>
      </div>
    </div>
  </section>
</Base>
