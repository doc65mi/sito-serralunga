---
/**
 * Vecchio indirizzo delle schede prodotto — Version: 1.01.
 * Se la scheda ha una categoria principale si va con un 301 all'indirizzo del Catalogo
 * (/catalogo/{categoria}/{slug}/); altrimenti la scheda si mostra qui.
 */
import SchedaProdotto from '../../components/SchedaProdotto.astro'
import { perSlug } from '../../lib/cms'
import { percorso, traduttore } from '../../lib/lingua'
import { categorie, urlProdotto } from '../../lib/catalogo'

const L = Astro.locals.lingua
const t = traduttore(L)
const p = await perSlug('prodotti', Astro.params.slug || '', 3, L)
if (!p || !p.schedaPubblicata) return Astro.rewrite('/404')
const tutte = await categorie(L)
const canonico = urlProdotto(p, tutte)
if (canonico !== `/prodotti/${p.slug}/`) return Astro.redirect(percorso(L, canonico), 301)
---
<SchedaProdotto p={p} tutte={tutte} briciole={[{ nome: t('Catalogo'), url: '/catalogo/' }]} />
