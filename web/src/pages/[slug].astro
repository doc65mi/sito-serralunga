---
/**
 * Pagine di servizio (Version: 1.01): Contatti, Listino, FAQ, pagine legali.
 * 1.01 (CMP): paragrafi che iniziano con «## » diventano titoli h2; la Cookie Policy elenca da sola
 * fornitori e cookie attivi (lib/cmp.ts) con il pulsante «Gestisci preferenze cookie».
 * Contenuto dalla collezione "pagine" del pannello; le domande frequenti arrivano dal blocco
 * "Domande e risposte" (dati strutturati FAQPage in Base.astro).
 */
import Base from '../layouts/Base.astro'
import Img from '../components/Img.astro'
import Testo from '../components/Testo.astro'
import ModuloRichiesta from '../components/ModuloRichiesta.astro'
import { impostazioni, perSlug, type Doc } from '../lib/cms'
import { isMedia } from '../lib/media'
import { piatto } from '../lib/testo'
import { traduttore } from '../lib/lingua'
import TabellaFornitori from '../components/TabellaFornitori.astro'
import { configCmp, NOME_CATEGORIA, privacyCookies } from '../lib/cmp'

const L = Astro.locals.lingua
const t = traduttore(L)
const p = await perSlug('pagine', Astro.params.slug || '', 2, L)
if (!p) return Astro.rewrite('/404')
const imp = await impostazioni(L)
const a = imp.azienda || {}
const tel = (a.telefono || '').replace(/[^+\d]/g, '')
const contatti = p.mostraContatti
// Pagine legali (CMP 1.00): la Cookie Policy mostra da sola fornitori e cookie attivi sul sito.
const pc = await privacyCookies(L)
const cmp = configCmp(imp, pc, L)
const slugDi = (l: string) => l.replace(/^\/(en\/)?/, '').replace(/\/$/, '')
const cookiePolicy = p.slug === slugDi(cmp.cookieLink)
const legale = cookiePolicy || p.slug === slugDi(cmp.privacyLink)
const aggiornata = legale && p.updatedAt ? new Date(p.updatedAt).toLocaleDateString(L === 'en' ? 'en-GB' : 'it-IT', { day: 'numeric', month: 'long', year: 'numeric' }) : ''
// Nei paragrafi, una riga che inizia con «## » è un titolo (h2).
const titoloDi = (x: string) => (typeof x === 'string' && x.startsWith('## ') ? x.slice(3).trim() : '')
---
<Base
  titolo={p.seo?.titolo || `${piatto(p.titolo)} | Serralunga`}
  descrizione={p.seo?.descrizione || p.intro}
  immagine={p.seo?.immagine || p.immagine}
  percorso={[{ nome: piatto(p.titolo), url: `/${p.slug}/` }]}
  tipoPagina={p.slug === 'contatti' ? 'ContactPage' : 'WebPage'}
  pagina={`pagina-${p.slug}`}
  doc={`collections/pagine/${p.id}`}
  blocchi={p.blocchi ?? []}
>
  <article>
    <header class="intro-pagina" id="pagina-intro">
      <div class="wrap intro-pagina__griglia">
        <div>
          {p.kicker && <span class="kicker" data-campo="kicker">{p.kicker}</span>}
          <h1 class="titolo titolo--display" data-campo="titolo">{p.titolo}</h1>
        </div>
        {p.intro && <Testo class="testo" campo="intro" t={p.intro} />}
      </div>
    </header>

    {isMedia(p.immagine) && (
      <div class="pad"><div class="wrap"><div class="foto r-219"><Img campo="immagine" media={p.immagine} priorita larghezza={2600} /></div></div></div>
    )}

    {(contatti || (p.paragrafi || []).length > 0) && (
      <section class="sez-int pad" id="pagina-testo">
        <div class="wrap pagina-servizio">
          {(p.paragrafi || []).length > 0 && (
            <div class="pagina-servizio__testo">
              {p.paragrafi.map((x: Doc, k: number) => titoloDi(x.testo) ? <h2>{titoloDi(x.testo)}</h2> : <Testo class="testo testo--forte" campo={`paragrafi.${k}.testo`} t={x.testo} />)}
              {aggiornata && <p class="pagina-legale__aggiornata">{t('Versione')} {cmp.versione} · {t('ultimo aggiornamento')}: <time datetime={p.updatedAt}>{aggiornata}</time></p>}
            </div>
          )}
          {contatti && (
            <address class="pagina-servizio__dati">
              <span class="kicker">{a.marchio || 'Serralunga'}</span>
              <span>{a.ragioneSociale}<br />{a.indirizzo}<br />{a.cap} {a.citta} ({a.provincia}), {a.paese}</span>
              {a.telefono && <a href={`tel:${tel}`}>{a.telefono}</a>}
              {a.email && <a href={`mailto:${a.email}`}>{a.email}</a>}
              {a.piva && <span>{t('P.IVA')} {a.piva}{a.rea ? ` · REA ${a.rea}` : ''}</span>}
            </address>
          )}
        </div>
      </section>
    )}

    {cookiePolicy && (
      <section class="sez-int pad pagina-legale__cookie" id="cookie-elenco" aria-labelledby="cookie-elenco-titolo">
        <div class="wrap">
          <h2 class="titolo titolo--l" id="cookie-elenco-titolo">{t('Cookie e fornitori usati su questo sito')}</h2>
          <p class="testo">{t('Elenco aggiornato automaticamente in base ai servizi attivi. Le categorie diverse da «Necessari» si attivano solo con il vostro consenso.')}</p>
          <p><button type="button" class="btn btn--scuro" data-cookie-preferenze aria-haspopup="dialog">{t('Gestisci preferenze cookie')}</button></p>
          {cmp.categorie.map((k) => (
            <>
              <h3>{t(NOME_CATEGORIA[k])}</h3>
              <p class="testo">{cmp.testi[k]}</p>
              <TabellaFornitori fornitori={cmp.fornitori.filter((f) => f.categoria === k)} />
              {cmp.script.some((x) => x.categoria === k) && <p class="testo">{t('Altri script')}: {cmp.script.filter((x) => x.categoria === k).map((x) => x.nome).join(', ')}</p>}
            </>
          ))}
        </div>
      </section>
    )}
  </article>

  {p.modulo?.mostra && (
    <section class="sez-int pad scuro" id="pagina-modulo" aria-labelledby="pagina-modulo-titolo">
      <div class="centro centro--s">
        <h2 class="titolo titolo--cta" id="pagina-modulo-titolo" data-campo="modulo.titolo">{p.modulo.titolo || t('Raccontateci il vostro progetto')}</h2>
        <ModuloRichiesta pulsante={p.modulo.pulsante || undefined} grazie={p.modulo.grazie || undefined} pagina={`/${p.slug}/`} />
      </div>
    </section>
  )}
</Base>
