# Variabili per Coolify — Version: 1.01
# In Coolify: applicazione → Environment Variables → Developer view → incollare e compilare.
# Le righe con # sono spiegazioni: si possono lasciare o togliere.

# Indirizzo interno del database PostgreSQL creato in Coolify:
# risorsa database → campo "Postgres URL (internal)". Si copia così com'è.
DATABASE_URL=postgres://serralunga:PASSWORD@NOME-DEL-DATABASE:5432/serralunga

# Indirizzo pubblico del sito, con https:// e senza barra finale (lo stesso messo in Domains sul servizio proxy).
# Da cambiare: è il dominio su cui gira il sito ora (in prova, per esempio https://serralunga1825.oltre.media).
SITO_URL=https://www.serralunga.com

# Primo utente del pannello (/admin). La password si cambia poi dal pannello.
SEED_EMAIL=
SEED_PASSWORD=

# 1 = al primo avvio, con il database vuoto, il sito carica da solo utente, testi e foto di partenza.
SEED_AUTOMATICO=1

# 1 = dopo un deploy con contenuti nuovi aggiunge da solo ciò che manca (pannello > Strumenti).
# Non modifica mai contenuti già presenti: le modifiche proposte si applicano a mano dal pannello.
AGGIORNAMENTO_AUTOMATICO=1

# 1 = sito chiuso a motori di ricerca e assistenti (prove). 0 = sito pubblico (lancio).
BLOCCA_INDICIZZAZIONE=1

# Facoltative: email di avviso a ogni richiesta dei moduli.
NOTIFICHE_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# NON vanno scritte qui: SERVICE_PASSWORD_64_PAYLOAD e SERVICE_PASSWORD_64_SITOCHIAVE.
# Le genera Coolify al primo caricamento del file compose e le conserva.
# Le chiavi API dell'AI (OpenAI, OpenRouter, Gemini) non sono variabili: si inseriscono
# nel pannello del sito, Impostazioni > Intelligenza artificiale, e vengono cifrate nel database.
