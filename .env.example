# Per l'uso in locale. Su Coolify le variabili si impostano dal pannello (vedi DEPLOY.md).
# Copia questo file in .env e cambia i valori (non caricare .env su GitHub).
POSTGRES_PASSWORD=cambia-questa-password
# Stringa lunga e casuale: per esempio il risultato di `openssl rand -hex 32`
PAYLOAD_SECRET=cambia-questo-segreto
# Chiave condivisa tra sito e CMS per salvare le richieste del modulo
SITO_CHIAVE=cambia-questa-chiave

# Indirizzo pubblico: sito e pannello (/admin) stanno sullo stesso indirizzo.
# In locale resta così; su Coolify diventa https://www.serralunga.com
SITO_URL=http://localhost:8080
# Porta sul PC (8080 per non scontrarsi con Laragon sulla 80)
PORTA=8080

# Primo utente del pannello, creato da `npm run seed` se non ci sono utenti
SEED_EMAIL=admin@serralunga.local
SEED_PASSWORD=cambia-questa-password

# 1 = chiede ai motori di non indicizzare (prove); 0 = sito pubblico
BLOCCA_INDICIZZAZIONE=1

# Email di avviso per le nuove richieste (facoltativo)
NOTIFICHE_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
